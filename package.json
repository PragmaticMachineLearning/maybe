{
  "name": "maybe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/server/dev.ts",
    "build": "tsc && tsc -p tsconfig.test.json && vite build",
    "check": "bun run lint && bun run test && bun run build && bun run test:e2e && bun run knip",
    "knip": "knip --no-progress",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "start": "bun run src/server/index.ts",
    "test": "bun test tests/unit --preload ./tests/setup.ts",
    "test:e2e": "playwright test",
    "test:watch": "bun test tests/unit --preload ./tests/setup.ts --watch",
    "preview": "bun run build && bun run start"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.53",
    "@ai-sdk/react": "^3.0.170",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.168",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "gaussformula": "^0.1.10",
    "hono": "^4.12.18",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "knip": "^6.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.9"
  },
  "packageManager": "bun@1.3.13"
}
