{
  "name": "probability-spreadsheet-root",
  "private": true,
  "workspaces": [
    ".",
    "hyperformula"
  ],
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "setup": "yarn install && cd hyperformula && yarn compile && yarn bundle:es && cd ..",
    "build:hyperformula": "cd hyperformula && yarn compile && yarn bundle:es && yarn bundle:development && cd .."
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.9",
    "@xyflow/react": "^12.6.4",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "elkjs": "^0.10.0",
    "gaussformula": "workspace:*",
    "gaussian": "^1.3.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.11.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "@types/gaussian": "^1.2.1",
    "@types/node": "^24.0.4",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "chart.js": "^4.4.9",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jasmine-core": "^5.7.1",
    "postcss": "^8.5.5",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vite": "^5.0.8"
  },
  "packageManager": "yarn@4.9.4"
}
